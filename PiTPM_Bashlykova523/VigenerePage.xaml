<Page x:Class="PiTPM_Bashlykova523.VigenerePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PiTPM_Bashlykova523"
      mc:Ignorable="d" 
      Background="#D2E2EC"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VigenerePage">

    <Grid VerticalAlignment="Center">
        <Border BorderBrush="#3A2119" BorderThickness="2" CornerRadius="10" Background="#D9CBC2" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="650" MinHeight="350" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="30,20,30,20">
                    <TextBlock Text="Введите текст:" FontSize="17" Foreground="#3A2119"/>
                    <TextBox x:Name="textEnterTB" FontSize="16" Height="35" Margin="0,2,0,0" BorderBrush="#3A2119" HorizontalAlignment="Stretch" PreviewTextInput="EnterTB_PreviewTextInput"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="30,0,30,15">
                    <TextBlock Text="Введите ключ:" FontSize="17" Foreground="#3A2119"/>
                    <TextBox x:Name="keyEnterTB" FontSize="16" Height="35" Margin="0,2,0,0" BorderBrush="#3A2119" HorizontalAlignment="Stretch" PreviewTextInput="EnterTB_PreviewTextInput"/>
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Background="#F5F2EF" CornerRadius="8" BorderBrush="#3A2119" BorderThickness="1" Padding="10" Margin="30,50,30,20" MaxWidth="450">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="resTextTBl" Text="текст:" FontSize="17" FontWeight="Bold" Foreground="#3A2119"/>
                        <TextBlock x:Name="resultTBl" Text="—" FontSize="16" Foreground="#3A2119" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="400"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,10,15,0">
                    <Button x:Name="encryptBtn" Content="Зашифровать" FontSize="18" Width="160" Height="50" Background="#8BA2C1" Margin="0,0,0,25" Click="encryptBtn_Click"/>
                    <Button x:Name="decryptBtn" Content="Расшифровать" FontSize="18" Width="160" Height="50" Background="#A3B87F" Click="decryptBtn_Click"/>

                    <Button x:Name="clearBtn" Content="Очистить" FontSize="18" Width="145" Height="50" Background="#C56967" Margin="0,60,0,10" Click="clearBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
