<Page x:Class="PiTPM_Bashlykova523.Pages.PageF1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PiTPM_Bashlykova523.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="460" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="PageF1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Функция №1" FontSize="21" FontWeight="Bold" Foreground="#442D1C" HorizontalAlignment="Center" Margin="0,15,0,5"/>
        <Image Grid.Row="1" Source="/Images/func1.png" Stretch="Uniform" Width="600" Height="90" HorizontalAlignment="Center" Margin="0,0,0,8" ToolTip="Математическая формула функции"/>

        <Border Grid.Row="2" Padding="8" Margin="40,0" CornerRadius="5" Background="#F7F2EE" BorderBrush="#3A2119" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="5,10,0,0">
                    <TextBlock Text="x:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,8,10,5"/>
                    <TextBlock Text="y:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,7,10,5"/>
                    <TextBlock Text="z:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,9,10,5"/>
                    <TextBlock Text="Ответ:   β =" FontSize="19" FontWeight="Bold" Foreground="#442D1C" HorizontalAlignment="Right" Margin="8,28,5,5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBox x:Name="xEnterTB" FontSize="17" Height="30" Margin="0,19,0,6" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" ToolTip="Введите значение переменной x"/>
                    <TextBox x:Name="yEnterTB" FontSize="17" Height="30" Margin="0,2,0,6" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" ToolTip="Введите значение переменной y"/>
                    <TextBox x:Name="zEnterTB" FontSize="17" Height="30" Margin="0,2,0,6" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" ToolTip="Введите значение переменной z"/>
                    <TextBox x:Name="ansTB" FontSize="17" Height="33" Width="160" Margin="0,20,0,0" IsReadOnly="True" ToolTip="Результат вычисления функции"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20,5,0,0">
                    <Button x:Name="countBtn" Content="Вычислить" FontSize="16" Height="45" Width="120" Margin="10,45,0,15" Background="#64854C" Foreground="#D9CBC2" Click="countBtn_Click" ToolTip="Вычислить значение функции"/>
                    <Button x:Name="clearBtn" Content="Очистить" FontSize="16" Height="45" Width="120" Margin="10,20,0,0" Background="#6B212C" Foreground="#D9CBC2" Click="clearBtn_Click" ToolTip="Очистить введённые значения"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="3" x:Name="nextFuncBtn" Content="Следующая функция" FontSize="17" Height="48" Width="210" Margin="0,12" Background="#3C507D" Foreground="#D9CBC2" HorizontalAlignment="Center" Click="nextFuncBtn_Click" ToolTip="Перейти к следующей функции"/>
    </Grid>
</Page>
