<Page x:Class="PiTPM_Bashlykova523.Pages.PageF3"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PiTPM_Bashlykova523.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="PageF3">

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Функция №3" FontSize="21" FontWeight="Bold" Foreground="#442D1C" HorizontalAlignment="Center" Margin="0,18,0,6"/>
        <Image Grid.Row="1" Source="/Images/func3.png" Stretch="Uniform" Width="420" Height="100" HorizontalAlignment="Center" ToolTip="Математическая формула функции"/>

        <Border Grid.Row="2" Padding="10" Margin="40,0" CornerRadius="6" Background="#F7F2EE" BorderBrush="#3A2119" BorderThickness="2">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="x₀:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,9,10,6"/>
                    <TextBlock Text="xₖ:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,6,10,6"/>
                    <TextBlock Text="dx:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,6,10,12"/>
                    <TextBlock Text="d:" FontSize="19" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,1,10,12"/>
                    <TextBlock Text="Результаты:" FontSize="19" FontWeight="Bold" Foreground="#442D1C" HorizontalAlignment="Right" Margin="0,30,10,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,10,0,0">
                    <TextBox x:Name="x0EnterTB" Height="28" FontSize="17" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" ToolTip="Введите начало отрезка x₀"/>
                    <TextBox x:Name="xkEnterTB" Height="28" FontSize="17" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" Margin="0,10,0,0" ToolTip="Введите конец отрезка xₖ"/>
                    <TextBox x:Name="dxEnterTB" Height="28" FontSize="17" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" Margin="0,8,0,10" ToolTip="Введите шаг приращения dx"/>
                    <TextBox x:Name="dEnterTB" Height="28" FontSize="17" TextChanged="EnterTB_TextChanged" PreviewTextInput="EnterTB_PreviewTextInput" ToolTip="Введите значение переменной d"/>
                    <TextBox x:Name="resultTB" Height="160" FontSize="17" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="Wrap" Margin="0,35,0,0" ToolTip="Список значений x и y"/>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="10,0,0,8" BorderBrush="#3A2119" BorderThickness="1" Background="#FFFFFF">
                        <wf:WindowsFormsHost Margin="5" ToolTip="График функции y = x² + tan(5x + d/x)">
                            <charts:Chart x:Name="Func3Chart">
                                <charts:Chart.Legends>
                                    <charts:Legend/>
                                </charts:Chart.Legends>
                            </charts:Chart>
                        </wf:WindowsFormsHost>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="countBtn" Content="Вычислить" Width="130" Height="45" FontSize="16" Background="#64854C" Foreground="#D9CBC2" Margin="0,0,10,0" ToolTip="Рассчитать значения и построить график" Click="countBtn_Click"/>
                        <Button x:Name="clearBtn" Content="Очистить" Width="130" Height="45" FontSize="16" Background="#6B212C" Foreground="#D9CBC2" ToolTip="Очистить все поля и график" Click="clearBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Button Grid.Row="3" x:Name="backBtn" Content="Назад" FontSize="17" Height="48" Width="120" Background="#A2676C" Foreground="#D9CBC2" HorizontalAlignment="Center" Margin="0,10" Click="backBtn_Click" ToolTip="Вернуться к предыдущей функции"/>
    </Grid>
</Page>
